{
  "Platforms": {
    "BattleNet": {
      "Identifiers": [ "b", "bnet", "battlenet", "blizzard" ],
      "ExeLocationDefault": "%ProgramFiles(x86)%\\Battle.net\\Battle.net.exe",
      "GetPathFromShortcutNamed": "Battle.net",
      "ExesToEnd": [ "Battle.net" ],
      "PathListToClear": [ "JSON_EMPTY_VALUE::%AppData%\\Battle.net\\Battle.net.config::Client.SavedAccountNames" ],
      "LoginFiles": {
        "JSON_SELECT_FIRST,::%AppData%\\Battle.net\\Battle.net.config::Client.SavedAccountNames": "email.json"
      },
      "AllFilesRequired": true,
      "ExitBeforeInteract": true,
      "UniqueIdFile": "%AppData%\\Battle.net\\Battle.net.config::Client.SavedAccountNames",
      "UniqueIdMethod": "JSON_SELECT_FIRST,",
      "Extras": {
        "ClosingMethod": "TaskKill",
        "BuiltInUsernameFile": "SQLITE:%LocalAppData%\\Battle.net\\CachedData.db|SELECT battle_tag FROM login_cache WHERE account_id_lo = '%BuiltInUserId%'",
        "BuiltInUserId": "LATEST_MODIFIED_FILE:%LocalAppData%\\Battle.net\\Logs\\battle.net-*.log"
      }
    },
    "Steam": {
      "Identifiers": [ "s", "steam", "valve" ],
      "ExeLocationDefault": "%ProgramFiles(x86)%\\Steam\\steam.exe",
      "GetPathFromShortcutNamed": "Steam",
      "ExesToEnd": [ "steam.exe" ],
      "PathListToClear": [ "SAME_AS_LOGIN_FILES" ],
      "LoginFiles": {
        "%Platform_Folder%\\config\\loginusers.vdf": "loginusers.vdf"
      },
      "AllFilesRequired": false,
      "ExitBeforeInteract": false,
      "UniqueIdFile": "%Platform_Folder%\\config\\loginusers.vdf",
      "UniqueIdMethod": "STEAM",
      "Extras": {
        "QuitArgs": "-shutdown",
        "BackupFolders": {
          "%Platform_Folder%\\config": "config",
          "%Platform_Folder%\\userdata": "userdata"
        },
        "BackupFileTypesInclude": [
          ".cfg",
          ".ini",
          ".dat",
          ".db",
          ".json",
          ".ProfileData",
          ".sav",
          ".save",
          ".nfo",
          ".txt",
          ".vcfg",
          ".vdf",
          ".vdf_last",
          ".vrmanifest",
          ".xml"
        ]
      }
    }
  }
}
